{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "screenshot",
  "description": "Overlay, pin, and recorder windows",
  "windows": [
    "screenshot-overlay-*",
    "screenshot-overlay-1",
    "screenshot-overlay-2",
    "screenshot-overlay-3",
    "screenshot-overlay-4",
    "screenshot-overlay-5",
    "screenshot-overlay-6",
    "screenshot-overlay-7",
    "screenshot-overlay-8",
    "screenshot-pin-1",
    "screenshot-pin-2",
    "screenshot-pin-3",
    "screenshot-pin-4",
    "screenshot-pin-5",
    "screenshot-pin-6",
    "screenshot-pin-7",
    "screenshot-pin-8",
    "screenshot-recorder",
    "screenshot-camera",
    "screenshot-scroll",
    "screenshot-scroll-frame-top",
    "screenshot-scroll-frame-right",
    "screenshot-scroll-frame-bottom",
    "screenshot-scroll-frame-left",
    "screenshot-record-frame-top",
    "screenshot-record-frame-right",
    "screenshot-record-frame-bottom",
    "screenshot-record-frame-left"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-close",
    "core:window:allow-set-focus",
    "core:window:allow-set-position",
    "core:window:allow-outer-position",
    "core:window:allow-scale-factor",
    "core:window:allow-set-size",
    "core:window:allow-start-dragging",
    "core:window:allow-set-always-on-top",
    "core:event:allow-listen",
    "core:event:allow-emit"
  ]
}
